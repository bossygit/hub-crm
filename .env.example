# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...votre-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJ...votre-service-role-key

# App
NEXT_PUBLIC_APP_URL=https://crm.hubdistribution.cg

# Email (Resend)
RESEND_API_KEY=re_votre-cle-resend

# Assistant IA (AI CEO Assistant)
# Fournisseur actif : AI_PROVIDER=ollama (défaut) ou deepseek.
# Si AI_PROVIDER est omis, DeepSeek est utilisé dès que DEEPSEEK_API_KEY existe,
# sinon Ollama. Surcharges optionnelles : AI_MODEL, AI_BASE_URL.
AI_PROVIDER=ollama
OLLAMA_API_KEY=ollama_votre-cle
AI_MODEL=gemma4:31b-cloud
# Bascule ultérieure vers DeepSeek (aucun changement de code nécessaire) :
# AI_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-votre-cle-deepseek
# AI_MODEL=deepseek-chat

# Tâches planifiées (Vercel Cron) — protège /api/notifications/scan et /api/invoices/remind
CRON_SECRET=une-chaine-aleatoire-longue
